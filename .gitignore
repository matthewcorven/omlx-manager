# OCR corpus page images are derived from scripts/ocr_corpus.py; only the
# manifest (ground truth) is committed.
results/non-llm/*/corpus/*.png

# Python bytecode
__pycache__/
*.pyc
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Local Copilot session config
.copilot/


# Playwright: reports and traces are ephemeral, never committed
playwright-report/
blob-report/
test-results/
playwright-reports/

# Playwright CI run logs (uploaded as artifacts, never committed)
.e2e-logs/

# Node
node_modules/

# oMLX release-reprofile working state (plan, catalogue, per-run JSON, batch logs)
# The catalogue is regenerated by `release_reprofile.py discover` on every
# release; committing it would make it look authoritative when it is a snapshot.
.reprofile/
